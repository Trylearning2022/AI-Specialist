# =====================================================================
# Cấu hình triển khai hệ thống AI Local – sao chép thành .env và sửa.
# scripts/init.sh tự sinh các khóa bí mật ngẫu nhiên khi .env chưa có.
# =====================================================================

# --- Địa chỉ truy cập (tên miền nội bộ) ---
AI_HOST=ai.noibo.local
AI_PUBLIC_URL=https://ai.noibo.local

# --- Xác thực: oidc (Keycloak) | dev (tài khoản thử nghiệm, KHÔNG dùng vận hành) ---
AUTH_MODE=oidc
# AUTH_MODE=dev chỉ dùng khi thử nghiệm, phải kèm DEV_AUTH_ALLOWED=true (gateway từ chối khởi động nếu thiếu).
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=__SINH_TU_DONG__
KC_INIT_ADMIN_PASSWORD=__SINH_TU_DONG__

# --- Khóa bí mật nội bộ ---
POSTGRES_PASSWORD=__SINH_TU_DONG__
INTERNAL_SECRET=__SINH_TU_DONG__
LITELLM_MASTER_KEY=__SINH_TU_DONG__
LLM_BACKEND_KEY=__SINH_TU_DONG__
QDRANT_API_KEY=__SINH_TU_DONG__

# --- Mức độ mật tối đa hệ thống được phép xử lý (0 Thường, 1 Mật, 2 Tối mật, 3 Tuyệt mật) ---
SYSTEM_MAX_CLEARANCE=0

# --- Mô hình (đặt tệp GGUF trong thư mục ./models) ---
# Cấp 1 (RAM 32–64 GB): LLM_MAIN_FILE=qwen3.5-9b-Q4_K_M.gguf, không chạy llm-small
# Cấp 2 (RAM 192–256 GB): LLM_MAIN_FILE=qwen3.6-35b-a3b-Q4_K_M.gguf, LLM_SMALL_FILE=qwen3.5-9b-Q4_K_M.gguf
LLM_MAIN_FILE=qwen3.6-35b-a3b-Q4_K_M.gguf
LLM_MAIN_CTX=65536
LLM_MAIN_PARALLEL=4
LLM_MAIN_THREADS=32
# --reasoning-budget 0: tắt chế độ suy luận dài (thinking) để giảm thời gian trên CPU
LLM_MAIN_EXTRA="--reasoning-budget 0"
LLM_SMALL_FILE=qwen3.5-9b-Q4_K_M.gguf
LLM_SMALL_CTX=16384
LLM_SMALL_PARALLEL=4
LLM_SMALL_THREADS=12
EMBED_FILE=vietnamese-embedding-f16.gguf
EMBED_THREADS=8
RERANK_FILE=bge-reranker-v2-m3-Q8_0.gguf
RERANK_THREADS=8

# Địa chỉ engine mà LiteLLM định tuyến tới:
#  - Chỉ có 01 mô hình: để LLM_SMALL_URL trỏ về llm-main (không bật profile "mo-hinh-nho")
#  - Có mô hình nhỏ riêng: LLM_SMALL_URL=http://llm-small:8080/v1 và chạy kèm --profile mo-hinh-nho
#  - Có GPU: dùng docker-compose.gpu.yml (LLM_MAIN_URL=http://vllm:8000/v1)
LLM_MAIN_URL=http://llm-main:8080/v1
LLM_SMALL_URL=http://llm-main:8080/v1
# Để trống RERANK_URL nếu không dùng reranker
RERANK_URL=http://rerank:8080

# --- Chuyển đổi tài liệu / OCR (docling-serve) ---
DOCLING_OCR_ENGINE=easyocr
DOCLING_OCR_LANG=vi,en

# --- Ngữ cảnh, harness ---
# Token dành cho phần nguồn (CPU: 4000; GPU: 8000–12000)
CTX_BUDGET_SOURCES=8000
# Độ dài tối đa câu trả lời Luồng A (token); quá thấp → câu trả lời bị cắt. CPU: 700–900; GPU: 1024–1500
ANSWER_MAX_TOKENS=1024
# Luồng B: true = sinh diễn giải ngay khi trả lời (chậm trên CPU); false = chỉ khi người dùng bấm "Giải thích ngắn gọn"
EXACT_LLM_INTERPRET=false

# --- Truy xuất Luồng A (chi tiết, cách chọn theo triệu chứng: docs/tinh-chinh-truy-xuat.md) ---
# Số mục đưa cho mô hình / số ứng viên mỗi nhánh tìm kiếm (CPU: 5 / 20; GPU: 6–8 / 30–50)
SEARCH_TOP_K=6
SEARCH_CANDIDATES=30
# Mục ngắn hơn ngưỡng này được đưa nguyên mục; dài hơn chỉ lấy đoạn trúng ± lân cận
SEARCH_SECTION_MAX_TOKENS=1200
# Số mục tối đa lấy từ một tài liệu (0 = không giới hạn)
SEARCH_MAX_PER_DOC=3
# Ngưỡng tuyệt đối và tương đối của reranker (logit)
RERANK_THRESHOLD=-2.0
RERANK_MARGIN=7.0
# Nhiệt độ sinh câu trả lời tra cứu (0.0–0.2: bám nguồn)
ANSWER_TEMPERATURE=0.1
# Kích thước đoạn khi lập chỉ mục (đổi giá trị ⇒ lập chỉ mục lại)
CHUNK_MAX_TOKENS=500
# Kiểm tra bám nguồn theo từng câu
VERIFY_GROUNDING=true
AGENT_MAX_STEPS=6
VERIFY_STRICT_A=true
ENABLE_AGENT=true
ENABLE_MCP=true
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_CHAT_PER_MIN=15
MAX_UPLOAD_MB=100

# --- Tích hợp (tùy chọn) ---
TICKET_WEBHOOK_URL=
KB_GIT_REMOTE=

# --- Phiên bản ảnh container (được ghim theo digest khi đóng gói, xem scripts/export-bundle.sh) ---
IMG_POSTGRES=postgres:17-bookworm
IMG_REDIS=redis:7.4-bookworm
IMG_QDRANT=qdrant/qdrant:latest
IMG_KEYCLOAK=quay.io/keycloak/keycloak:26.4
IMG_LLAMACPP=ghcr.io/ggml-org/llama.cpp:server
IMG_LITELLM=ghcr.io/berriai/litellm:main-stable
IMG_DOCLING=quay.io/docling-project/docling-serve-cpu:latest
IMG_NGINX=nginx:1.27-alpine
IMG_GITEA=gitea/gitea:1.24-rootless
IMG_PROMETHEUS=prom/prometheus:latest
IMG_VLLM=vllm/vllm-openai:latest
IMG_APP=ai-local/backend:1.4.4
IMG_PORTAL=ai-local/portal:1.4.4

# ---------------- 1.3.0: tác vụ dài, hỏi lại, bảo vệ ATTT, giám định dữ liệu, giám sát ----------------
# Hồ sơ phần cứng: cpu | gpu (gpu: bật kiểm tra chéo bằng mô hình mọi lúc, có thể tăng AGENT_WORKERS)
HARDWARE_PROFILE=cpu
# Hỏi lại khi câu hỏi chưa rõ (heuristic, không tốn mô hình); CLARIFY_MAX_SCORE: điểm rerank coi là "phân tán"
CLARIFY_ENABLED=true
CLARIFY_MAX_SCORE=0.0
# Chặn bí mật xác thực (PIN, mật khẩu, khóa bí mật), yêu cầu vượt bảo mật, dấu độ mật vượt cấp
GUARD_ENABLED=true
# Tác vụ dài nhường mô hình cho hỏi đáp trực tiếp tối đa N giây trước mỗi lượt gọi (CPU 120–300; GPU 0–30)
AGENT_YIELD_MAX_S=180
AGENT_PART_TOKENS=3000
AGENT_MAX_CRITERIA=20
AGENT_WORKERS=1
# Giám định dữ liệu: chu kỳ (phút, 0 = chỉ chạy tay); dùng mô hình kiểm tra chéo: off | auto | on; giờ rảnh
QA_INTERVAL_MIN=120
QA_LLM_MODE=auto
QA_LLM_HOURS=22-6
TELEMETRY_ENABLED=true

# ---- Kho văn bản đã ban hành, tham gia ý kiến (1.4.0) ----
# Xây dựng ảnh có LibreOffice để nạp tệp .doc/.xls cũ: INSTALL_LIBREOFFICE=1 docker compose build
INSTALL_LIBREOFFICE=0
AGENT_PRECEDENTS=2
AGENT_GOPY_MAX_PASSAGES=8
AGENT_GOPY_DEF_SIMILARITY=0.5
